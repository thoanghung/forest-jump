{
  "name": "forest-jump",
  "version": "0.1.0",
  "description": "Jump between git worktrees and run their dev env in one click",
  "main": "./out/main/index.js",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "electron-vite build",
    "start": "electron-vite preview",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "rebuild": "electron-rebuild -f -w node-pty",
    "postinstall": "electron-rebuild -f -w node-pty",
    "dist": "electron-vite build && electron-builder --linux AppImage deb"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "electron",
      "node-pty",
      "esbuild"
    ]
  },
  "dependencies": {
    "chokidar": "^4.0.3",
    "node-pty": "1.1.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.2.1",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "@xterm/addon-fit": "~0.10.0",
    "@xterm/xterm": "^5.5.0",
    "electron": "^44.11.1",
    "electron-builder": "^26.18.0",
    "electron-vite": "^6.0.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "typescript": "^5.9.3",
    "vite": "^7.3.8",
    "vitest": "^3.2.7"
  },
  "build": {
    "appId": "dev.local.forest-jump",
    "productName": "Forest Jump",
    "directories": {
      "output": "dist"
    },
    "files": [
      "out/**/*"
    ],
    "asarUnpack": [
      "**/node_modules/node-pty/**"
    ],
    "linux": {
      "target": [
        "AppImage",
        "deb"
      ],
      "category": "Development",
      "executableName": "forest-jump",
      "maintainer": "thoanghung",
      "syncDesktopName": true,
      "synopsis": "Jump between git worktrees and run their dev env"
    },
    "artifactName": "${name}-${version}-${arch}.${ext}"
  },
  "author": "forest-jump",
  "productName": "Forest Jump",
  "desktopName": "forest-jump.desktop"
}
